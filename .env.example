# GEMINI_API_KEY: Required for Gemini AI API calls in LIVE mode.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_MODE: Controls whether the backend executes fast simulated mock jobs ("mock")
# or live Google Gemini API calls ("live"). Can also be toggled at runtime in Studio Settings.
AI_MODE="mock"

# Configurable Gemini models used by the backend service layer:
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"
GEMINI_VISION_MODEL="gemini-3.8-flash"
GEMINI_TEXT_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

