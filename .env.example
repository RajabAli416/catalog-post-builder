# Supabase Auth. Create a project at https://supabase.com and enable the Email provider.
# For instant sign-in, turn off Confirm email under Authentication settings.
# Use the same URL and anon key for the browser (VITE_) and the API.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# GEMINI_API_KEY: Required. Create one in Google AI Studio and set it in Vercel
# Project Settings > Environment Variables, then redeploy.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# On Vercel, create a Blob store under Storage. That sets BLOB_READ_WRITE_TOKEN
# so projects, garment photos, and generated shoots persist between requests.

# Configurable Gemini models used by the backend service layer:
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"
GEMINI_VISION_MODEL="gemini-3.8-flash"
GEMINI_TEXT_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

